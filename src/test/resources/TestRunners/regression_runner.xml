<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="TRUECALLER-ENTERPRISE-SDK-API-REGRESSION-SUITE" thread-count="1"
       parallel="tests" verbose="4">

    <listeners>
        <listener
                class-name="sdk.enterprise.Listeners.ExtentReportListener"/>
    </listeners>

    <test name="ProjectServiceTest">
        <parameter name="baseURI" value="https://oauth-account-noneu.truecaller.com/portal"/>
        <classes>
            <class name= "sdk.enterprise.Tests.ProjectServiceTest.ProjectTest"/>
        </classes>
    </test>

    <test name="PartnerServiceTest">
        <parameter name="baseURI" value="https://oauth-account-noneu.truecaller.com/portal"/>
        <classes>
            <class name= "sdk.enterprise.Tests.PartnerServiceTest.PartnerTest"/>
        </classes>
    </test>


</suite>